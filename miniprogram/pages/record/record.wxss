.section-title{font-size:31rpx;font-weight:700;margin-bottom:20rpx}.subjects{display:flex;flex-wrap:wrap;gap:14rpx}.pill{padding:11rpx 16rpx;border-radius:14rpx;background:#f2f5f9;color:#607185;font-size:23rpx}.selected{background:#e7f1ff;color:#1677ff}.new-category{border:1rpx dashed #6ca7ec;background:#fff;color:#1677ff}.material-meta{margin:18rpx 0}.source-chip{display:inline-block;padding:10rpx 14rpx;border-radius:12rpx;background:#edf6ff;color:#1677ff;font-size:23rpx}.material-title{margin-top:14rpx;width:auto}.note{width:auto;height:160rpx}.photos{display:flex;flex-wrap:wrap;gap:14rpx;margin:18rpx 0}.photos image,.thumbs image{width:132rpx;height:132rpx;border-radius:12rpx}.photo-btn{font-size:23rpx;margin:0;background:#f1f6fc;color:#1677ff;border-radius:12rpx}.row{display:flex;justify-content:space-between}.content{margin-top:18rpx;font-size:27rpx;line-height:1.6}.record-title{display:block;margin-top:14rpx;font-size:29rpx;font-weight:700;color:#27394e}.record-title+.content{margin-top:10rpx}.selectable{display:block}.copy-text{display:inline-block;margin-top:10rpx;font-size:23rpx;color:#1677ff}.thumbs{display:flex;gap:12rpx;margin-top:14rpx}.record-wrap{margin-bottom:18rpx}.focused-record{outline:3rpx solid #78b4ff;outline-offset:8rpx;border-radius:16rpx}.record-actions{display:flex;border-radius:0 0 24rpx 24rpx;overflow:hidden}.action{flex:1;line-height:78rpx;text-align:center;color:#fff;font-size:25rpx;font-weight:700}.pin{background:#e9a019}.delete{background:#e65050}.file-unavailable{background:#fff8e8;border:1rpx solid #f0c36b;border-radius:12rpx;padding:12rpx;margin-top:12rpx;color:#8a5b08}.file-reason{display:block;margin-top:6rpx;font-size:22rpx;color:#9b6b14}
.filter-card{padding:18rpx;margin:-4rpx 0 20rpx;border-radius:18rpx;background:#f7faff;border:1rpx solid #dce9f6}.filter-card input{box-sizing:border-box;width:100%;height:66rpx;padding:0 16rpx;border-radius:12rpx;background:#fff;font-size:24rpx}.filter-row{white-space:nowrap;margin-top:14rpx}.filter-chip{display:inline-block;margin-right:12rpx;padding:9rpx 14rpx;border-radius:999rpx;background:#edf2f7;color:#607185;font-size:22rpx}.filter-chip.active{background:#e0efff;color:#1677ff;font-weight:700}.clear-filter{display:inline-block;margin-top:14rpx;font-size:22rpx;color:#1677ff}.empty{text-align:center;color:#8a99a8;padding:42rpx 25rpx}.empty .clear-filter{margin-left:12rpx}
