.weekly-review-card,.reminder-card,.source-card{margin-bottom:24rpx}.review-grid{display:flex;margin:26rpx 0 16rpx}.review-metric{flex:1;display:flex;flex-direction:column;gap:8rpx;align-items:center;font-size:22rpx;color:#718196;border-right:1rpx solid #dfe8f2}.review-metric:last-child{border-right:none}.review-number{font-size:38rpx;line-height:1;color:#1677ff;font-weight:700}.weak-box{margin-top:20rpx;padding:16rpx;border-radius:14rpx;background:#fff7e8}.weak-title{font-size:25rpx;font-weight:700;color:#9b6816}.weak-item{display:flex;justify-content:space-between;font-size:23rpx;color:#775320;margin-top:10rpx}.reminder-card{display:flex;align-items:center;justify-content:space-between;gap:16rpx;background:linear-gradient(135deg,#f8fbff,#eef6ff);border:1rpx solid #d9e9ff}.reminder-card>view{flex:1}.reminder-title{font-size:26rpx;font-weight:700;color:#244a70;margin-top:12rpx}.subscription-status{font-size:21rpx;line-height:1.5;color:#75879b;margin-top:14rpx}.go-review,.copy-source{margin:0;background:#1677ff;color:#fff;border-radius:12rpx;font-size:22rpx;white-space:nowrap}.source-row{display:flex;align-items:center;gap:14rpx;padding:20rpx 0;border-top:1rpx solid #edf1f5}.source-main{flex:1;min-width:0}.source-subject{font-size:22rpx;color:#1677ff;font-weight:700}.source-title{font-size:26rpx;font-weight:700;color:#36506a;margin:6rpx 0}.source-usage{font-size:21rpx;line-height:1.45;color:#8a6a2c;margin-top:7rpx}.source-local{font-size:21rpx;white-space:nowrap;color:#8191a2}
