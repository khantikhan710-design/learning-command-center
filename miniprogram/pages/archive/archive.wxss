.intro{margin-bottom:24rpx}.title{font-size:38rpx;font-weight:700}.weekly{margin-bottom:24rpx}.weekly-total{font-size:48rpx;font-weight:700;color:#1677ff;margin:14rpx 0}.bar-chart{height:290rpx;display:flex;align-items:flex-end;justify-content:space-between;gap:10rpx;margin:28rpx 0 8rpx;padding:8rpx 4rpx 0;border-bottom:2rpx solid #dfe8f2}.bar-column{height:100%;flex:1;display:flex;min-width:0;flex-direction:column;align-items:center;justify-content:flex-end}.bar-value{height:32rpx;font-size:20rpx;color:#68809a}.bar-track{height:200rpx;width:100%;display:flex;align-items:flex-end;justify-content:center}.bar-fill{width:58%;min-height:0;border-radius:12rpx 12rpx 0 0;background:linear-gradient(180deg,#5aa7ff,#1677ff)}.bar-label{margin-top:9rpx;font-size:19rpx;color:#718196}.metric-row{margin-top:18rpx}.metric-top{display:flex;justify-content:space-between;font-size:24rpx;color:#36506a}.metric-top text:last-child{color:#1677ff}.metric-track{height:14rpx;margin-top:10rpx;border-radius:999rpx;background:#eaf1f8;overflow:hidden}.metric-fill{height:100%;border-radius:999rpx;background:#35a5ff}.task-track{background:#edf7f1}.task-fill{background:#43b581}.folder{margin-bottom:18rpx}.folder-head{display:flex;justify-content:space-between;align-items:center}.month{font-size:30rpx;font-weight:700;margin-bottom:8rpx}.subhead{font-size:27rpx;font-weight:700;color:#36506a;margin:22rpx 0 10rpx}.entry{padding:16rpx 0;border-top:1rpx solid #edf1f5;font-size:26rpx;line-height:1.55}.entry-meta{font-size:22rpx;color:#78899b;margin-bottom:7rpx}.export-actions,.backup-actions{display:flex;gap:14rpx;margin:22rpx 0 4rpx}.copy-summary,.copy-obsidian,.restore-toggle,.preview-backup,.restore-confirm{margin:0;background:#eef5ff;color:#1677ff;border-radius:12rpx;font-size:23rpx}.copy-obsidian{background:#ecf8f1;color:#16824b}.backup{margin-bottom:24rpx}.backup-title{font-size:30rpx;font-weight:700;color:#36506a}.backup-status{display:inline-block;margin-top:16rpx;padding:9rpx 13rpx;border-radius: