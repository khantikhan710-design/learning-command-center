.title{font-size:36rpx;font-weight:700}.types{display:flex;gap:14rpx;margin:24rpx 0;flex-wrap:wrap}.pill{padding:11rpx 16rpx;border-radius:14rpx;background:#f2f5f9;color:#607185;font-size:23rpx}.selected{background:#e7f1ff;color:#1677ff}.new-category{border:1rpx dashed #6ca7ec;background:#fff;color:#1677ff}.note{width:auto;height:180rpx}.section{font-size:31rpx;font-weight:700;margin:34rpx 0 16rpx}.item{display:flex;gap:16rpx;justify-content:space-between}.item-content{font-size:28rpx;line-height:1.55;margin:18rpx 0}.related-record{display:block;margin-top:12rpx;color:#1677ff;font-size:23rpx}.buttons{display:flex;gap:14rpx;margin-top:18rpx;flex-wrap:wrap}.buttons button{margin:0}.prompt-box{margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#f5f9ff}.prompt-title{font-size:25rpx;font-weight:700;color:#2e75c9;margin-bottom:10rpx}.prompt{font-size:24rpx;line-height:1.55;color:#52657a;margin-top:10rpx}.mastered-folder{background:#f7faf8}.mastered{text-decoration:line-through;color:#8c9a94}.mastered .muted,.mastered .undo,.mastered .delete-mini,.mastered .related-record{text-decoration:none}.undo{margin:16rpx 12rpx 0 0;background:#edf3ee;color:#4c7660;font-size:22rpx}.delete-mini{margin:16rpx 0 0;background:#fff0f0;color:#d54848;font-size:22rpx}.buttons .delete-mini{margin:0}.empty{text-align:center;color:#8a99a8;padding:70rpx 25rpx}
.due-card{border:1rpx solid #d9e9ff;background:linear-gradient(135deg,#f8fbff,#eef6ff)}.coach-title{font-size:32rpx;font-weight:700;color:#244a70}.coach-message{font-size:25rpx;line-height:1.55;color:#526b85;margin:12rpx 0 24rpx}.due-title{font-size:31rpx;font-weight:700;color:#244a70}.due-empty{font-size:25rpx;color:#718096;margin-top:18rpx}.due-item{padding:20rpx 0;border-bottom:1rpx solid #dce9f6}.due-item:last-of-type{border-bottom:none}.due-content{font-size:27rpx;line-height:1.55}.due-item button{margin:16rpx 0 0;background:#fff;color:#1677ff;border:1rpx solid #8dbdff;font-size:22rpx}.due-more{margin-top:18rpx;font-size:23rpx;color:#718096}
.curve-card{margin-top:22rpx}.curve-head{display:flex;justify-content:space-between;gap:16rpx;align-items:flex-start}.curve-head>text{padding:8rpx 13rpx;border-radius:999rpx;background:#fff5e9;color:#dc812d;font-size:22rpx;white-space:nowrap}.curve-title{font-size:30rpx;font-weight:700;color:#36506a;margin-bottom:7rpx}.curve-canvas{display:block;width:100%;height:300rpx;margin-top:18rpx;background:#fbfdff;border-radius:12rpx}.curve-milestones{display:flex;justify-content:space-between;gap:6rpx;margin-top:18rpx}.curve-node{flex:1;display:flex;min-width:0;flex-direction:column;align-items:center;gap:7rpx;color:#9aa8b6;font-size:19rpx}.node-dot{width:15rpx;height:15rpx;border-radius:50%;background:#b4c0ce}.curve-node.done{color:#1677ff}.curve-node.done .node-dot{background:#1677ff}.curve-node.current{color:#df8230;font-weight:700}.curve-node.current .node-dot{width:20rpx;height:20rpx;background:#f2994a;box-shadow:0 0 0 7rpx #fff0df}.curve-next{margin-top:22rpx;font-size:22rpx}
.filter-card{padding:18rpx;margin:-4rpx 0 20rpx;border-radius:18rpx;background:#f7faff;border:1rpx solid #dce9f6}.filter-card input{box-sizing:border-box;width:100%;height:66rpx;padding:0 16rpx;border-radius:12rpx;background:#fff;font-size:24rpx}.filter-row{white-space:nowrap;margin-top:14rpx}.filter-chip{display:inline-block;margin-right:12rpx;padding:9rpx 14rpx;border-radius:999rpx;background:#edf2f7;color:#607185;font-size:22rpx}.filter-chip.active{background:#e0efff;color:#1677ff;font-weight:700}.clear-filter{display:inline-block;margin-top:14rpx;font-size:22rpx;color:#1677ff}.empty{text-align:center;color:#8a99a8;padding:42rpx 25rpx}.empty .clear-filter{margin-left:12rpx}
