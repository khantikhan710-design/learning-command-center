.daily-loop{margin-top:42rpx;background:linear-gradient(135deg,#f8fbff,#eef6ff);border:1rpx solid #dbeaff}.loop-title{font-size:30rpx;font-weight:700;color:#244a70}.loop-grid{display:flex;margin:26rpx 0 22rpx}.loop-metric{flex:1;text-align:center;border-right:1rpx solid #d9e6f2}.loop-metric:last-child{border-right:none}.loop-value{font-size:31rpx;font-weight:700;color:#1677ff}.loop-label{font-size:22rpx;color:#718096;margin-top:8rpx}.loop-actions{display:flex;gap:16rpx}.loop-actions button{flex:1;margin:0;background:#1677ff;color:#fff;border-radius:14rpx;font-size:24rpx}.loop-actions .loop-review{background:#fff;color:#1677ff;border:1rpx solid #8dbdff}
