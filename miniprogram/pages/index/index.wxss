.hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#103a5c,#1677ff);padding:54rpx 34rpx 38rpx;color:#fff;border-radius:0 0 38rpx 38rpx;margin:-28rpx -28rpx 28rpx}.mascot{position:absolute;right:-16rpx;bottom:-20rpx;width:210rpx;height:210rpx;opacity:.94}.headline{font-size:48rpx;font-weight:700;margin-top:16rpx}.sub,.muted{font-size:25rpx;color:#718096;margin-top:12rpx}.hero .sub{color:#dcecff;width:72%}.goal-edit{color:#fff;text-decoration:underline}.picker-card{background:#fff;border-radius:24rpx;padding:25rpx;margin:0 0 25rpx}.picker-title{font-size:28rpx;font-weight:700;text-align:center}.wheel-shell{position:relative;margin-top:12rpx}.wheel{height:216rpx}.wheel-item{height:72rpx;line-height:72rpx;text-align:center;font-size:32rpx;color:#36506a}.wheel-pointer{position:absolute;top:50%;width:0;height:0;transform:translateY(-50%);z-index:2;pointer-events:none;border-top:12rpx solid transparent;border-bottom:12rpx solid transparent}.left-pointer{left:24rpx;border-left:18rpx solid #1677ff}.right-pointer{right:24rpx;border-right:18rpx solid #1677ff}.goal-tip{text-align:center;margin-top:6rpx}.start{margin:28rpx 0 0;background:#fff;color:#1269d3;border-radius:16rpx;font-weight:700}.section{font-size:32rpx;font-weight:700;margin:30rpx 0 16rpx}.task,.add{display:flex;align-items:center}.task-wrap{margin-bottom:18rpx}.task{margin-bottom:0}.check{width:38rpx;height:38rpx;border:3rpx solid #b5c2d2;border-radius:50%;margin-right:20rpx;text-align:center;line-height:38rpx;color:#fff}.checked{background:#21b26b;border-color:#21b26b}.task-main{flex:1;font-size:29rpx;font-weight:600}.done{text-decoration:line-through;color:#9aa8b6}.duration{font-size:23rpx;color:#1677ff;background:#eef5ff;padding:12rpx;border-radius:12rpx}.task-actions{display:flex;overflow:hidden;border-radius:0 0 24rpx 24rpx}.action{flex:1;margin:0;border-radius:0;color:#fff;font-size:25rpx;font-weight:700;line-height:78rpx;text-align:center}.pin{background:#e9a019}.category{background:#