<view class="page"><view class="hero"><image class="mascot" src="/assets/study-dragon-mascot.png" mode="aspectFit"/><view>{{date}}</view><view class="headline">今天，稳步前进</view><view class="sub">已完成 {{completed}} / {{total}} 项 · <text class="goal-edit" bindtap="editGoal">目标 {{goalLabel}}学习 · 修改</text></view><view class="meter"><view class="meter-fill" style="width:{{progress}}%"></view></view><view class="sub">专注 {{focusMinutes}} 分钟 · {{progress}}% · 连续 {{streak}} 天</view><button class="start" bindtap="goFocus">开始一次专注</button></view><view class="section">今日任务</view><block wx:for="{{pendingTasks}}" wx:key="id"><view class="task-wrap"><view class="card task" data-id="{{item.id}}" bindtouchstart="onTaskTouchStart" bindtouchend="onTaskTouchEnd"><view class="check" data-id="{{item.id}}" catchtap="toggle"></view><view class="task-main"><view>{{item.pinned?'📌 ':''}}{{item.title}}</view><view class="muted">{{item.subject}}</view></view><picker range="{{durationOptions}}" data-id="{{item.id}}" bindchange="changeDuration"><view class="duration">{{item.minutes ? item.minutes + ' 分钟' : '设置时长'}}</view></picker></view><view wx:if="{{activeTaskId===item.id}}" class="task-actions"><view class="action pin" data-id="{{item.id}}" bindtap="togglePin">{{item.pinned?'取消置顶':'置顶'}}</view><view class="action category" data-id="{{item.id}}" bindtap="chooseCategory">分类</view><view class="action delete" data-id="{{item.id}}" bindtap="confirmDelete">删除</view></view></view></block><view wx:if="{{completedTasks.length}}" class="completed-divider"><view class="divider-line"></view><view class="completed-label">已完成 {{completedTasks.length}} 项</view><view class="divider-line"></view></view><block wx:for="{{completedTasks}}" wx:key="id"><view class="task-wrap completed-wrap"><view class="card task" data-id="{{item.id}}" bindtouchstart="onTaskTouchStart" bindtouchend="onTaskTouchEnd"><view class="check checked" data-id="{{item.id}}" catchtap="toggle">✓</view><view class="task-main"><view class="done">{{item.pinned?'📌 ':''}}{{item.title}}</view><view class="muted">{{item.subject}}</view></view><picker range="{{durationOptions}}" data-id="{{item.id}}" bindchange="changeDuration"><view class="duration">{{item.minutes ? item.minutes + ' 分钟' : '设置时长'}}</view></picker></view><view wx:if="{{activeTaskId===item.id}}" class="task-actions"><view class="action pin" data-id="{{item.id}}" bindtap="togglePin">{{item.pinned?'取消置顶':'置顶'}}</view><view class="action category" data-id="{{item.id}}" bindtap="chooseCategory">分类</view><view class="action delete" data-id="{{item.id}}" bindtap="confirmDelete">删除</view></view></view></block><view class="swipe-tip">向左滑动任务卡，可置顶、分类或删除</view><view class="card add"><input value="{{newTask}}" placeholder="添加今天的新任务" bindinput="setNewTask" bindconfirm="addTask"/><button size="mini" bindtap="addTask">添加</button></view></view>
